{
  "include": ["src", "src/types.d.ts"],
  "compilerOptions": {
    /* 🔧 Language and Environment */
    "target": "ESNext",
    "jsx": "react",

    /* 🔧 Modules */
    "module": "commonjs",

    /* 🔧 Emit */
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist/types/",

    /* 🔧 Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* 🔧 Type Checking */
    "strict": true,
    "noImplicitAny": false,

    /* 🔧 Completeness */
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    /* 🧩 Clave para resolver @scratch/scratch-vm */
    "baseUrl": "./src",
    "paths": {
      "@scratch/scratch-vm": ["../../scratch-vm/src"],
      "scratch-vm": ["../../scratch-vm/src"]
    },

    /* 🧠 Type roots para que reconozca declaraciones locales */
    "typeRoots": [
      "./src/types",
      "../../scratch-vm/src",
      "../../node_modules/@types"
    ]
  }
}
